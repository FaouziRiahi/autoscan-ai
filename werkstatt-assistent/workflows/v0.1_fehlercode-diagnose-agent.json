          }
        ]
      ]
    },
    "KI-Diagnose-Agent": {
      "main": [
        [
          {
            "node": "Bericht zusammenstellen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bericht zusammenstellen": {
      "main": [
        [
          {
            "node": "Ergebnis anzeigen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "KI-Diagnose-Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
